# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/microminds

# ── Monad / Alchemy ──────────────────────────────────────────────────────────
ALCHEMY_RPC_URL=https://monad-testnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
OPERATOR_PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY

# ── Escrow Contract ───────────────────────────────────────────────────────────
ESCROW_ADDRESS=0xYOUR_ESCROW_CONTRACT_ADDRESS
# Set to "true" to skip on-chain transactions during local development
ESCROW_MOCK=false

# ── Privy (access token verification for POST /api-keys) ──────────────────────
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
# Set to "true" to skip Privy signature verification during local development
PRIVY_MOCK=false

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
